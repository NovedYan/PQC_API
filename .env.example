# ==========================================
# PQC / PUF Configuration Example
# ==========================================

DJANGO_SECRET_KEY=replace-with-your-own-secret-key

# ------------------------------------------
# Random Source
# ------------------------------------------
#
# system:
#   使用系統安全亂數
#
# puf:
#   使用外部 PUF Random API
#
PQC_RANDOM_MODE=system


# ------------------------------------------
# PUF Random API
# ------------------------------------------
#
# 當 PQC_RANDOM_MODE=puf 時才會使用。
#
# 請修改成 PUF Server 的實際 IP 與 Port。
#
# Example:
# PUF_ENDPOINT=http://192.168.1.100:9000/api/random/
#
PUF_ENDPOINT=http://127.0.0.1:9000/api/random/


# ------------------------------------------
# HTTP Timeout
# ------------------------------------------

PUF_TIMEOUT=5